# Repo-root ignores. The mobile app has its own .gitignore in mobile/.

# OS
.DS_Store

# Secrets — never commit
.env
.env.*
!.env.example

# Python / backend
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
node_modules

# Build artifacts — the real Android/iOS projects live in mobile/ and are
# covered by mobile/.gitignore. These guard against stray copies at the root.
.gradle/
.cxx/
.kotlin/
build/
