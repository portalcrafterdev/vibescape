# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
DEBUG=true

# Postgres. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://USER@localhost:5432/vibescape_dev

# Redis. Use a dedicated logical DB index — this instance is shared with other projects.
REDIS_URL=redis://localhost:6379/1

# Comma-separated exact origins. Never "*" when credentials are allowed.
CORS_ORIGINS=http://localhost:8081

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required in production; a dev-only fallback is used when DEBUG=true.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

MAX_REQUEST_BODY_BYTES=10485760

# Serve /docs, /redoc, /openapi.json and /api/v1/docs.
# Defaults to DEBUG. Set to true to expose docs on a staging box without debug mode.
# ENABLE_DOCS=true

PASSWORD_RESET_EXPIRE_MINUTES=30

# Brute-force protection. Lock duration doubles each time, capped.
MAX_FAILED_LOGINS=5
LOCKOUT_BASE_MINUTES=1
LOCKOUT_MAX_MINUTES=60

# Sliding-window rate limits.
RATE_LIMIT_AUTH_PER_IP=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_ENABLED=true

# --- media storage (S3-compatible: AWS S3, Cloudflare R2, Spaces, MinIO) ---
# Leave S3_BUCKET empty in development to use the local-disk fallback.
# Required in production — startup fails without it.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
UPLOAD_URL_EXPIRE_SECONDS=300
MEDIA_URL_EXPIRE_SECONDS=3600
RATE_LIMIT_UPLOADS_PER_USER=30
