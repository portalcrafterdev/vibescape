{
  "openapi": "3.1.0",
  "info": {
    "title": "Vibescape API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness and dependency check.\n\nThe database is required, so losing it is \"down\" and returns 503. Redis is a cache,\nso losing it is \"degraded\" and still returns 200 \u2014 the app serves from Postgres.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Database"
          },
          "cache": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Cache"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "cache"
        ],
        "title": "HealthResponse"
      }
    }
  }
}
